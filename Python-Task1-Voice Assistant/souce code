import sys
import time
import datetime
import webbrowser
import urllib.parse

import pyttsx3
import pyaudiowpatch as pyaudio

# Make PyAudioWPatch compatible with SpeechRecognition
sys.modules["pyaudio"] = pyaudio

import speech_recognition as sr


# -----------------------------
# TEXT TO SPEECH: Assistant talks
# -----------------------------

engine = pyttsx3.init("sapi5")
engine.setProperty("rate", 170)
engine.setProperty("volume", 1.0)


def speak(message):
    """Print and speak the assistant's reply."""
    print("Assistant:", message)

    engine.say(str(message))
    engine.runAndWait()


# -----------------------------
# SPEECH TO TEXT: Assistant listens
# -----------------------------

recognizer = sr.Recognizer()


def listen():
    """Listen through the microphone and convert speech to text."""

    try:
        with sr.Microphone() as source:
            print("\nListening... Speak now.")

            recognizer.adjust_for_ambient_noise(
                source,
                duration=0.5
            )

            audio = recognizer.listen(
                source,
                timeout=8,
                phrase_time_limit=10
            )

        print("Recognizing...")

        text = recognizer.recognize_google(audio)
        print("You:", text)

        return text.lower().strip()

    except sr.WaitTimeoutError:
        print("No speech detected.")
        return ""

    except sr.UnknownValueError:
        speak("Sorry, I couldn't understand that.")
        return ""

    except sr.RequestError:
        speak("Speech recognition needs an internet connection.")
        return ""

    except Exception as error:
        print("Microphone error:", error)
        speak("There is a microphone problem.")
        return ""


# -----------------------------
# BASIC FEATURES
# -----------------------------

def tell_time():
    current_time = datetime.datetime.now().strftime("%I:%M %p")
    speak(f"The time is {current_time}")


def tell_date():
    current_date = datetime.datetime.now().strftime("%A, %d %B %Y")
    speak(f"Today is {current_date}")


def google_search(topic):
    if not topic:
        speak("Please tell me what you want to search.")
        return

    search_url = (
        "https://www.google.com/search?q="
        + urllib.parse.quote_plus(topic)
    )

    webbrowser.open(search_url)
    speak(f"Searching Google for {topic}")


def youtube_search(topic):
    if not topic:
        speak("Please tell me what to search on YouTube.")
        return

    search_url = (
        "https://www.youtube.com/results?search_query="
        + urllib.parse.quote_plus(topic)
    )

    webbrowser.open(search_url)
    speak(f"Searching YouTube for {topic}")


def open_website(website):
    websites = {
        "google": "https://www.google.com",
        "youtube": "https://www.youtube.com",
        "gmail": "https://mail.google.com",
        "github": "https://github.com",
        "linkedin": "https://www.linkedin.com",
    }

    if website in websites:
        webbrowser.open(websites[website])
        speak(f"Opening {website}")
    else:
        speak("I don't know that website yet.")


# -----------------------------
# COMMAND HANDLER
# -----------------------------

def handle_command(command):

    if not command:
        return True

    if "hello" in command or "hi assistant" in command:
        speak("Hello! How can I help you?")

    elif "your name" in command:
        speak("I am your personal voice assistant.")

    elif "time" in command:
        tell_time()

    elif "date" in command:
        tell_date()

    elif command.startswith("search youtube for "):
        topic = command.replace("search youtube for ", "", 1)
        youtube_search(topic)

    elif command.startswith("search youtube "):
        topic = command.replace("search youtube ", "", 1)
        youtube_search(topic)

    elif command.startswith("search for "):
        topic = command.replace("search for ", "", 1)
        google_search(topic)

    elif command.startswith("search "):
        topic = command.replace("search ", "", 1)
        google_search(topic)

    elif command.startswith("open "):
        website = command.replace("open ", "", 1).strip()
        open_website(website)

    elif "goodbye" in command or "stop assistant" in command:
        speak("Goodbye! Have a nice day.")
        return False

    else:
        speak("I don't know that command yet. You can ask me to search the web.")

    return True


# -----------------------------
# MAIN PROGRAM
# -----------------------------

def main():

    speak(
        "Voice assistant is ready. "
        "Say hello, ask for the time, or say goodbye to stop."
    )

    running = True

    while running:
        command = listen()
        running = handle_command(command)


if __name__ == "__main__":
    main()
